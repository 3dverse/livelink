{
  "compilerOptions": {
    "jsx": "react",
    "outDir": "dist",
    "target": "ES2022",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "./sources",
    "skipLibCheck": true,
    "types": ["vite/client"],
    "module": "es2022"
  },

  "include": ["./sources"],
  "exclude": ["./sources/**/*.stories.ts", "./sources/**/*.stories.tsx"]
}
