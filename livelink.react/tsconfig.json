{
  "compilerOptions": {
    "jsx": "react",
    "outDir": "dist",
    "rootDir": "./sources",
    "target": "ES2022",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "types": ["@types/wicg-file-system-access"]
  },

  "exclude": ["./dist/**/*"]
}
