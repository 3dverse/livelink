{
  "name": "@3dverse/livelink-base",
  "version": "0.8.64",
  "private": true,
  "description": "Shared headless core (session, scene, entities) for the 3dverse livelink client SDKs. Not published: consumed as a source folder, bundled into the livelink client SDKs via the @livelink.base/* alias.",
  "scripts": {
    "generate": "node ci/auto-generate.js ../../node_modules/ ci/ ./_prebuild/",
    "build": "npm run generate",
    "lint": "eslint sources _prebuild",
    "clean": "rimraf _prebuild dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm run generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@3dverse/livelink.core": "^1.1.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
