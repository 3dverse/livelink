# `@3dverse/livelink-agent` is a `file:..` dependency. Without this, npm symlinks it in
# node_modules, so Node resolves its dist/index.cjs to its *real* path outside samples/ and
# never finds node-opcua-client here. install-links makes npm copy it instead, keeping
# dist/index.cjs (and its node_modules lookup) inside samples/.
install-links=true
