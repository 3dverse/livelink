{
    // Exists solely so the VS Code TypeScript language server auto-discovers a config for the sample
    // scripts. tsserver only picks up files literally named `tsconfig.json`; the root config's
    // program is sources-only, so without this the editor drops the samples into an inferred project
    // with no `types: ["node"]` (an immediate "Cannot find name 'process'") and no `paths` mapping.
    // This delegates to the samples program, which also backs ESLint's type-aware rules.
    //
    // Same shim as `tests/tsconfig.json`, for the same reason — don't delete it because the CLI
    // passes without it: `npm run typecheck:samples` names its config explicitly, the editor cannot.
    "extends": "../tsconfig.samples.json"
}
