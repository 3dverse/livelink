{
  // Exists solely so the VS Code TypeScript language server auto-discovers a config for test
  // files. tsserver only picks up files literally named `tsconfig.json`; the root config's program
  // is sources-only, so without this the editor drops tests into an inferred project with no `paths`
  // mapping and the `@livelink.base/*` alias fails to resolve. This delegates to the full test
  // program (sources + tests + ambient globals), which also backs ESLint's type-aware rules.
  "extends": "../tsconfig.test.json"
}
